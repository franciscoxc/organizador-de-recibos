<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 habilita las API de Windows: el OCR (Windows.Media.Ocr). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>Organizador de Recibos</AssemblyName>
    <Title>Organizador de Recibos</Title>
    <Product>Organizador de Recibos</Product>
    <!-- La versión real la pone el workflow desde el tag; 0.0.0 marca una compilación local. -->
    <Version>0.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WPF y no WinForms: el tema Fluent trae de Windows el Mica, el modo oscuro y los controles de
         Windows 11, y las animaciones van por la placa de video. -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Solo el pdfium.dll nativo (x64 y ARM64): dibuja las hojas para el OCR, ver WindowsOcr.cs. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="158.0.8111" />
    <!-- Instancia fija (wght 400) de Caveat[wght].ttf de google/fonts, hecha con fontTools.varLib.instancer:
         la variable trae todos los grosores y pesa más. -->
    <EmbeddedResource Include="Caveat-Regular.ttf" LogicalName="Caveat-Regular.ttf" />
    <!-- El ícono grande de la tarjeta. -->
    <Resource Include="app.png" />
  </ItemGroup>
  <ItemGroup>
    <!-- WPF saca estos dos de los using implícitos (Path choca con System.Windows.Shapes.Path) y el motor
         los usa en todos lados. En la ventana, las formas van con el alias Formas. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
</Project>
