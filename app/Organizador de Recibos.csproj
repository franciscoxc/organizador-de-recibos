<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041 habilita las API de Windows: el OCR (Windows.Media.Ocr) y el render de PDF (Windows.Data.Pdf). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- WFO1000 pide atributos para el diseñador de WinForms, que este proyecto no usa. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <AssemblyName>Organizador de Recibos</AssemblyName>
    <Title>Organizador de Recibos</Title>
    <Product>Organizador de Recibos</Product>
    <!-- La versión real la pone el workflow desde el tag; 0.0.0 marca una compilación local. -->
    <Version>0.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- Solo el pdfium.dll nativo (x64 y ARM64): dibuja las hojas para el OCR, ver WindowsOcr.cs. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="158.0.8111" />
    <!-- Instancia fija (wght 400) de Caveat[wght].ttf de google/fonts, hecha con fontTools.varLib.instancer:
         la variable trae todos los grosores y pesa más. -->
    <EmbeddedResource Include="Caveat-Regular.ttf" LogicalName="Caveat-Regular.ttf" />
  </ItemGroup>
</Project>
